# Copy this file to .env and replace the placeholder values.
# .env is ignored by git; never commit real credentials.
# Every setting AnimeVerse reads is listed here.

# --- Required ---------------------------------------------------------------
POSTGRES_USER=animeverse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=animeverse

# --- Optional (defaults shown) ------------------------------------------------
# Where the database is. localhost = the Docker container on this computer.
POSTGRES_HOST=localhost
# Port on your computer; change it if 5432 is already in use.
POSTGRES_PORT=5432
# SSL for the database connection: disable, allow, prefer, require, verify-ca, verify-full.
# A managed database in the cloud (e.g. AWS RDS) should use require or stronger.
POSTGRES_SSLMODE=prefer
# Seconds to wait for the database to accept a new connection.
POSTGRES_CONNECT_TIMEOUT=10
# How much the commands log: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Where the API contract is (relative to the folder you run commands from).
# `animeverse serve` serves it at /v1/openapi.yaml.
OPENAPI_PATH=openapi.yaml
